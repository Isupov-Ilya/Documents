{
  "$defs": {
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "conflict_group_id": {
          "title": "Conflict Group Id",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Fact Ids",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "conflict_group_id",
        "fact_ids",
        "explanation"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "DateInfo": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year",
            "period",
            "unknown"
          ],
          "title": "Precision",
          "type": "string"
        },
        "approximate": {
          "title": "Approximate",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "precision",
        "approximate"
      ],
      "title": "DateInfo",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "title": "Fact Id",
          "type": "string"
        },
        "human_reviewed": {
          "default": false,
          "title": "Human Reviewed",
          "type": "boolean"
        },
        "subject_person_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Person Id"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "evidence_type": {
          "enum": [
            "reported",
            "inferred",
            "unclear"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "certainty": {
          "enum": [
            "explicit",
            "approximate",
            "ambiguous"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "has_conflict": {
          "default": false,
          "title": "Has Conflict",
          "type": "boolean"
        },
        "conflict_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Group Id"
        },
        "requires_review": {
          "default": false,
          "title": "Requires Review",
          "type": "boolean"
        }
      },
      "required": [
        "fact_id",
        "subject_person_id",
        "predicate",
        "value",
        "evidence",
        "evidence_type",
        "certainty"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Mention": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "text"
      ],
      "title": "Mention",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "title": "Person Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "relationship_to_respondent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship To Respondent"
        },
        "identity_status": {
          "enum": [
            "explicit",
            "inferred_from_context",
            "ambiguous"
          ],
          "title": "Identity Status",
          "type": "string"
        },
        "mentions": {
          "items": {
            "$ref": "#/$defs/Mention"
          },
          "minItems": 1,
          "title": "Mentions",
          "type": "array"
        }
      },
      "required": [
        "person_id",
        "identity_status",
        "mentions"
      ],
      "title": "Person",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "subject_person_id": {
          "title": "Subject Person Id",
          "type": "string"
        },
        "object_person_id": {
          "title": "Object Person Id",
          "type": "string"
        },
        "relationship": {
          "title": "Relationship",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "requires_review": {
          "default": true,
          "title": "Requires Review",
          "type": "boolean"
        }
      },
      "required": [
        "subject_person_id",
        "object_person_id",
        "relationship",
        "evidence"
      ],
      "title": "Relation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "people": {
      "items": {
        "$ref": "#/$defs/Person"
      },
      "title": "People",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "title": "Relations",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/Conflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    }
  },
  "required": [
    "people",
    "facts"
  ],
  "title": "FactSet",
  "type": "object"
}
